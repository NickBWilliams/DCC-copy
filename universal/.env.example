# Copy to .env and keep it out of Git. Never put Terraboost credentials here.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DCC_OWNER_EMAIL=nicholas.byron.williams@gmail.com
DCC_ORGANIZATION_SLUG=personal
DCC_ENV=development
DCC_PUBLIC_URL=http://localhost:8000

# HeiGIT account: https://account.heigit.org/
HEIGIT_API_KEY=
# Basic Key: Directions V2 confirmed; VROOM not confirmed.
DCC_HEIGIT_USE_VROOM=false

# Optional dedicated/self-hosted OSRM server (takes precedence over HEIGIT).
DCC_OSRM_BASE_URL=
# Developer-only demo; MUST remain false in commercial production.
DCC_ALLOW_PUBLIC_OSRM=false

# Required for production sign-in links; not needed to test locally.
DCC_SMTP_HOST=
DCC_SMTP_PORT=587
DCC_SMTP_FROM=
DCC_SMTP_USER=
DCC_SMTP_PASSWORD=
