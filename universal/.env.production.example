# Copy to .env.production on the SERVER only; chmod 600 .env.production.
# Never commit a filled secrets file to GitHub or share tokens in chat.
DCC_DOMAIN=dispatch.example.com
DCC_OWNER_EMAIL=nicholas.byron.williams@gmail.com
DCC_ORGANIZATION_SLUG=personal
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_40_CHAR_ALPHANUMERIC_PASSWORD

# Existing personal HeiGIT account, configure key securely ON SERVER.
HEIGIT_API_KEY=REPLACE_WITH_PERSONAL_ROUTING_KEY
DCC_HEIGIT_USE_VROOM=false
DCC_OSRM_BASE_URL=

# SMTP provider needed before production sign-in can work.
DCC_SMTP_HOST=smtp.example.com
DCC_SMTP_PORT=587
DCC_SMTP_FROM=login@dispatch.example.com
DCC_SMTP_USER=REPLACE
DCC_SMTP_PASSWORD=REPLACE

# Unique per-deployment Fernet key; generate securely on the server only.
# Never commit an actual key in this example or upload it to a repository.
DCC_CONNECTOR_ENCRYPTION_KEY=
# Optional in private dev; REQUIRED allowlist in a commercial production build.
DCC_CONNECTOR_ALLOWED_HOSTS=

# Contractor offer maps: use an approved/licensed tile provider for paid SaaS.
# OSM public tiles are available only in private development preview.
# Tile URLs are public browser configuration: NEVER include server-only secrets.
DCC_MAP_TILES_URL=
DCC_MAP_TILES_ATTRIBUTION=
